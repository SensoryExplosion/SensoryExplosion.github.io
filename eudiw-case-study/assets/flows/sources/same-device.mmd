flowchart LR
  A[Tap Continue with<br/>EUDI Wallet] --> B[Wallet opens through<br/>same-device link]
  B --> C[Wallet authenticates relying party<br/>and validates registration and request]
  C --> D{Requester and<br/>request valid?}
  D -- No --> E{Wallet policy}
  E -- Block --> F[Blocked;<br/>no attributes shared]
  E -- Warn and continue --> G[Show high-severity<br/>warning]
  D -- Yes --> H[Review identity, purpose and privacy,<br/>retention intent and<br/>mandatory or optional attributes]
  G --> H
  H --> I{Only registered<br/>attributes requested?}
  I -- Yes --> J[Review final request]
  I -- No --> K{Apply wallet policy}
  K -- Reject all --> L[Request rejected;<br/>no attributes shared]
  K -- Registered only --> M[Limit to registered attributes]
  K -- Allow all --> N[Show exception warning]
  M --> J
  N --> J
  J --> O{Choose to share?}
  O -- No --> P[Decline request;<br/>no attributes shared]
  O -- Yes --> Q[Authenticate to<br/>confirm approval]
  Q --> R[Present approved attributes]
  R --> S[Show wallet and service outcome<br/>with activity record]
  classDef start fill:#00adfe,color:#ffffff,stroke:#00adfe,stroke-width:2px
  classDef secondary fill:#ffffff,color:#29334f,stroke:#d5dbe0,stroke-width:1px
  classDef decision fill:#00adfe14,color:#29334f,stroke:#00adfe,stroke-width:2px
  classDef action fill:#00adfe14,color:#29334f,stroke:#00adfe,stroke-width:1.5px
  classDef warning fill:#f7f6f6,color:#29334f,stroke:#9aa4ad,stroke-width:1.5px
  classDef success fill:#00adfe14,color:#29334f,stroke:#00adfe,stroke-width:1.5px
  class A start
  class B,C,G,H,J,M,N,Q,R secondary
  class D,E,I,K,O decision
  class F,L,P warning
  class S success
