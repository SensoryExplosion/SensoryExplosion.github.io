flowchart LR
  A[Choose Present or<br/>respond to reader] --> B[Establish QR, NFC or<br/>nearby handoff]
  B --> C[Show requester and<br/>requested attributes]
  C --> D{Online verification needed<br/>but unavailable?}
  D -- Yes --> E[Explain verification limitation<br/>and safest action]
  D -- No --> F[Approval decision]
  E --> F
  F --> G{Approve?}
  G -- No --> H[End without presentation]
  G -- Yes --> I[Authenticate user]
  I --> J[Transfer]
  J --> K{Confirmed?}
  K -- Yes --> L[Success receipt]
  K -- No --> M[Uncertain or failed state;<br/>state whether data may have left]
  classDef start fill:#00adfe,color:#ffffff,stroke:#00adfe,stroke-width:2px
  classDef secondary fill:#ffffff,color:#29334f,stroke:#d5dbe0,stroke-width:1px
  classDef decision fill:#00adfe14,color:#29334f,stroke:#00adfe,stroke-width:2px
  classDef warning fill:#f7f6f6,color:#29334f,stroke:#9aa4ad,stroke-width:1.5px
  classDef success fill:#00adfe14,color:#29334f,stroke:#00adfe,stroke-width:1.5px
  class A start
  class B,C,F,I,J secondary
  class D,G,K decision
  class E,H,M warning
  class L success
